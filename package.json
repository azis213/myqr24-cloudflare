{
  "name": "myqr24-cloudflare",
  "version": "0.2.0",
  "private": true,
  "description": "myQR24 Cloudflare edge router and public tag application.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:router",
    "dev:router": "npm run dev --workspace=@myqr24/edge-router",
    "dev:app": "npm run dev --workspace=@myqr24/tag-app",
    "dev:tcc": "npm run dev --workspace=@myqr24/tag-control-center",
    "build": "npm run build:router && npm run build:app && npm run build:app-api && npm run build:media-signer",
    "build:router": "npm run build --workspace=@myqr24/edge-router",
    "build:codec": "npm run build:codec --workspace=@myqr24/edge-router",
    "build:app": "npm run build --workspace=@myqr24/tag-app",
    "build:app-api": "npm run build:app-api --workspace=@myqr24/tag-app",
    "build:media-signer": "npm run build:media-signer --workspace=@myqr24/tag-app",
    "build:tcc": "npm run build --workspace=@myqr24/tag-control-center",
    "test": "npm run test:router && npm run test:app",
    "test:router": "npm run test --workspace=@myqr24/edge-router",
    "test:app": "npm run test --workspace=@myqr24/tag-app",
    "test:tcc": "npm run test --workspace=@myqr24/tag-control-center",
    "test:watch": "npm run test:watch --workspace=@myqr24/edge-router",
    "deploy": "npm run deploy:router",
    "deploy:router": "npm run deploy --workspace=@myqr24/edge-router",
    "deploy:router:staging": "npm run deploy:staging --workspace=@myqr24/edge-router",
    "deploy:app": "npm run deploy --workspace=@myqr24/tag-app",
    "deploy:app:staging": "npm run deploy:staging --workspace=@myqr24/tag-app",
    "tag-lab": "node tools/tag-lab/server.mjs",
    "local:up": "powershell -ExecutionPolicy Bypass -File test/10-test-local/scripts/start-local-test.ps1",
    "local:rebuild": "powershell -ExecutionPolicy Bypass -File test/10-test-local/scripts/start-local-test.ps1 -Rebuild",
    "local:down": "powershell -ExecutionPolicy Bypass -File test/10-test-local/scripts/stop-local-test.ps1",
    "local:reset": "powershell -ExecutionPolicy Bypass -File test/10-test-local/scripts/reset-local-test.ps1",
    "local:test": "powershell -ExecutionPolicy Bypass -File test/10-test-local/scripts/test-local-test.ps1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
