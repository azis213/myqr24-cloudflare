# Local tooling configuration only.
#
# Copy to tools/.env.local and generate separate local values.
# Do not copy Staging or Production values to a developer workstation.
# `tools/.env.local` is ignored by Git.
#
# Cloudflare Edge Router and internal TAG Codec Worker use these names.
# Production/Staging values are stored only in Cloudflare Worker secrets.
#
# All cryptographic values below must contain at least 32 random bytes.
# Use 64 lowercase hexadecimal characters for the portable local representation.

# Cloudflare Edge Router + internal TAG Codec Worker:
# Feistel round-key material. It must remain stable for a tag population.
FEISTEL_SECRET_S01=replace-with-64-random-hex-characters

# Cloudflare Edge Router + internal TAG Codec Worker:
# HMAC key for the 4-bit integrity check of eight-character tags.
TAG_HMAC_SECRET_S01=replace-with-64-random-hex-characters

# Cloudflare Edge Router only:
# HMAC key for short-lived signed redirect URLs.
REDIRECT_SIGNING_SECRET_S01=replace-with-64-random-hex-characters

# Internal TAG Codec Worker + server-side TAG Control Plane only:
# Independent, rotatable API authentication key. Never expose to a browser.
TAG_CODEC_API_KEY_S01=replace-with-64-random-hex-characters

# Local-only, comma-separated, non-production test tag identifiers.
# This is not a cryptographic secret but must not contain customer or live-tag data.
TEST_TAGS=replace-with-local-test-tag-ids
