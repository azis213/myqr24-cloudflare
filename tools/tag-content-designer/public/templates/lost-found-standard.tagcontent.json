{
  "schema": "myqr24-tag-content-template-v1",
  "schemaVersion": 1,
  "template": {
    "templateId": "tct_lost_found_standard",
    "templateVersion": 1,
    "tagType": "lost-found",
    "name": "Lost & Found – Standard",
    "description": "Fundhinweis, Kontaktweg und optionale Fundfotos.",
    "locale": "de-DE",
    "status": "draft",
    "compatibility": { "protectionModes": ["public"], "presentations": ["standard"] }
  },
  "shell": {
    "presentation": "standard",
    "features": ["vault", "lost-found"],
    "theme": {
      "colorMode": "light",
      "colors": {
        "background": "#fff7e6",
        "surface": "#ffffff",
        "text": "#211c10",
        "mutedText": "#6b6046",
        "heading": "#3b2b0b",
        "accent": "#b45309",
        "accentText": "#ffffff",
        "border": "#f0e2c4",
        "danger": "#b3261e",
        "success": "#1b6b3a"
      },
      "typography": { "fontFamily": "system", "headingScale": 1.1, "bodySize": 17, "lineHeight": 1.55 },
      "layout": { "contentWidth": "narrow", "density": "comfortable", "cornerStyle": "round" }
    },
    "navigation": { "mode": "single", "items": [] },
    "statusBar": { "showTagId": true, "showPresentation": false }
  },
  "layout": {
    "mode": "grid-flow",
    "columns": 12,
    "gap": "md",
    "container": { "maxWidth": "narrow", "padding": "normal" },
    "responsive": {
      "autoReflow": true,
      "minColumnWidth": { "tablet": "16rem", "desktop": "18rem" },
      "preferredColumns": { "mobile": 1, "tablet": 2, "desktop": 2 }
    }
  },
  "editability": {
    "allow": [
      "content.heading",
      "content.paragraphs",
      "style.background.color",
      "style.headingColor",
      "placement.span",
      "placement.order"
    ],
    "limits": { "allowRemoveElements": true, "maxRemovedElements": 1, "allowReorder": true, "minRemainingElements": 2 }
  },
  "elements": [
    {
      "elementId": "cel_theme",
      "elementType": "theme-assets",
      "displayOrder": 0,
      "visibility": "public",
      "hidden": true,
      "payload": { "role": "background" },
      "slots": [{ "slotId": "tag-background", "accepts": ["image"], "min": 0, "max": 1, "required": false }]
    },
    {
      "elementId": "cel_finder_notice",
      "elementType": "finder-notice",
      "displayOrder": 10,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 12 },
        "order": { "mobile": 10, "tablet": 10, "desktop": 10 }
      },
      "payload": { "urgency": "high" },
      "content": {
        "heading": "Sie haben diesen Gegenstand gefunden?",
        "paragraphs": [
          {
            "runs": [
              { "text": "Vielen Dank. Bitte nutzen Sie die Funktion " },
              { "text": "„Fund melden“", "marks": [{ "type": "bold" }] },
              { "text": ", damit der Eigentümer informiert werden kann." }
            ]
          }
        ]
      }
    },
    {
      "elementId": "cel_owner_text",
      "elementType": "text",
      "displayOrder": 20,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 6, "desktop": 6 },
        "order": { "mobile": 20, "tablet": 20, "desktop": 20 }
      },
      "payload": { "headingLevel": "h2", "align": "start", "maxParagraphs": 4 },
      "content": {
        "heading": "Zum Gegenstand",
        "paragraphs": [{ "runs": [{ "text": "Dieses TAG kennzeichnet einen persönlichen Gegenstand." }] }]
      }
    },
    {
      "elementId": "cel_finder_form",
      "elementType": "finder-form",
      "displayOrder": 30,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 6, "desktop": 6 },
        "order": { "mobile": 30, "tablet": 30, "desktop": 30 }
      },
      "payload": { "channel": "server-mediated" },
      "content": {
        "heading": "Fund melden",
        "paragraphs": [
          { "runs": [{ "text": "Ihre Angaben werden ausschließlich zur Kontaktaufnahme verwendet." }] }
        ]
      },
      "slots": [
        { "slotId": "photos", "accepts": ["image"], "min": 0, "max": 3, "required": false }
      ]
    },
    {
      "elementId": "cel_contact",
      "elementType": "contact-channel",
      "displayOrder": 40,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 12 },
        "order": { "mobile": 40, "tablet": 40, "desktop": 40 }
      },
      "payload": { "method": "form" },
      "content": { "heading": "Kontakt", "paragraphs": [{ "runs": [{ "text": "Der Kontakt erfolgt über eine serverseitige Vermittlung." }] }] }
    }
  ]
}
