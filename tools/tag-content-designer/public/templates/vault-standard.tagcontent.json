{
  "schema": "myqr24-tag-content-template-v1",
  "schemaVersion": 1,
  "template": {
    "templateId": "tct_vault_standard",
    "templateVersion": 1,
    "tagType": "vault",
    "name": "Vault – Standard",
    "description": "Öffentliche Standardansicht: Titel, Hinweis, Text, Galerie und Dokumente.",
    "locale": "de-DE",
    "status": "draft",
    "compatibility": {
      "protectionModes": ["public", "pin_required"],
      "presentations": ["standard"]
    }
  },
  "shell": {
    "presentation": "standard",
    "features": ["vault"],
    "theme": {
      "colorMode": "light",
      "colors": {
        "background": "#f7f5f0",
        "surface": "#ffffff",
        "text": "#1c1c1c",
        "mutedText": "#5a5a5a",
        "heading": "#14231c",
        "accent": "#1f513d",
        "accentText": "#ffffff",
        "border": "#e2ded6",
        "danger": "#b3261e",
        "success": "#1b6b3a"
      },
      "typography": { "fontFamily": "system", "headingScale": 1, "bodySize": 16, "lineHeight": 1.55 },
      "layout": { "contentWidth": "narrow", "density": "comfortable", "cornerStyle": "soft" }
    },
    "navigation": { "mode": "single", "items": [] },
    "statusBar": { "showTagId": true, "showPresentation": false }
  },
  "layout": {
    "mode": "grid-flow",
    "columns": 12,
    "gap": "md",
    "container": { "maxWidth": "wide", "padding": "normal" },
    "responsive": {
      "autoReflow": true,
      "minColumnWidth": { "tablet": "16rem", "desktop": "18rem" },
      "preferredColumns": { "mobile": 1, "tablet": 2, "desktop": 3 }
    }
  },
  "editability": {
    "allow": [
      "content.heading",
      "content.paragraphs",
      "style.background.color",
      "style.headingColor",
      "style.textColor",
      "placement.span",
      "placement.order",
      "payload.display",
      "payload.picker.axis",
      "slots.images.max"
    ],
    "limits": {
      "allowRemoveElements": true,
      "maxRemovedElements": 2,
      "allowReorder": true,
      "allowThemeImage": true,
      "minRemainingElements": 1
    }
  },
  "elements": [
    {
      "elementId": "cel_theme",
      "elementType": "theme-assets",
      "displayOrder": 0,
      "visibility": "public",
      "hidden": true,
      "payload": { "role": "background" },
      "slots": [
        { "slotId": "tag-background", "accepts": ["image"], "min": 0, "max": 1, "required": false }
      ]
    },
    {
      "elementId": "cel_intro",
      "elementType": "text",
      "displayOrder": 10,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 8 },
        "order": { "mobile": 10, "tablet": 10, "desktop": 10 }
      },
      "style": { "background": { "type": "solid", "color": "surface" }, "padding": "md" },
      "payload": { "headingLevel": "h2", "align": "start", "maxParagraphs": 8 },
      "content": {
        "heading": "Willkommen",
        "paragraphs": [
          {
            "runs": [
              { "text": "Diese Ansicht gehört zu einem myQR24 TAG. " },
              { "text": "Alle Inhalte sind öffentlich.", "marks": [{ "type": "bold" }] }
            ]
          }
        ]
      }
    },
    {
      "elementId": "cel_notice",
      "elementType": "callout",
      "displayOrder": 20,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 4 },
        "order": { "mobile": 20, "tablet": 20, "desktop": 20 }
      },
      "payload": { "tone": "info" },
      "content": {
        "heading": "Hinweis",
        "paragraphs": [
          { "runs": [{ "text": "Private Inhalte werden in dieser öffentlichen Ansicht nicht angezeigt." }] }
        ]
      }
    },
    {
      "elementId": "cel_gallery",
      "elementType": "gallery",
      "displayOrder": 30,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 8 },
        "order": { "mobile": 30, "tablet": 30, "desktop": 30 }
      },
      "payload": {
        "name": "Eindrücke",
        "picker": { "axis": "horizontal", "thumbSize": "md", "showCounter": true },
        "viewer": { "sizeMode": "medium", "swipe": true, "loop": false, "showCaptions": true },
        "lightbox": true,
        "maxImages": 48
      },
      "content": { "heading": "Eindrücke" },
      "actions": {
        "upload": {
          "enabled": true,
          "principals": ["guest", "owner"],
          "acceptedTypes": ["image"],
          "maxItemsPerPrincipal": 3,
          "maxFileSizeMb": 10,
          "afterUpload": "quarantine"
        },
        "download": { "enabled": true, "principals": ["scanner", "guest", "owner"] },
        "delete": { "enabled": true, "principals": ["owner", "guest"], "guestScope": "ownOnly" }
      },
      "editability": {
        "allow": ["content.heading", "payload.picker.axis", "payload.viewer.sizeMode", "placement.span"]
      },
      "slots": [
        {
          "slotId": "images",
          "accepts": ["image"],
          "min": 0,
          "max": 48,
          "required": false,
          "presentation": { "fit": "cover", "caption": "optional" }
        }
      ]
    },
    {
      "elementId": "cel_docs",
      "elementType": "documents",
      "displayOrder": 40,
      "visibility": "shared",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 12 },
        "order": { "mobile": 40, "tablet": 40, "desktop": 40 }
      },
      "payload": { "view": "list", "showMeta": true, "sort": "date-desc", "maxItems": 32 },
      "content": { "heading": "Dokumente" },
      "actions": {
        "upload": { "enabled": false },
        "download": { "enabled": true, "principals": ["guest", "owner"] }
      },
      "slots": [
        { "slotId": "documents", "accepts": ["document"], "min": 0, "max": 32, "required": false }
      ]
    }
  ]
}
