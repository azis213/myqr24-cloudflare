{
  "name": "@myqr24/tag-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Local browser application for generating and printing myQR24 QR tags.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
