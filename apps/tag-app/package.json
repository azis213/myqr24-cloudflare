{
  "name": "@myqr24/tag-app",
  "version": "0.1.0",
  "private": true,
  "description": "myQR24 public scan and tag feature PWA.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:wlan": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist --project-name myqr24-tag-app",
    "deploy:staging": "npm run build && wrangler pages deploy dist --project-name myqr24-staging-test-pwa"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.144.0"
  }
}
