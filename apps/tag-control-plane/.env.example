APP_NAME="myQR24 Tag Control Plane"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myqr24
DB_USERNAME=myqr24_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Local development can use `log`; staging/production uses Dogado SMTP over
# implicit TLS. MAIL_PASSWORD is a deployment secret and must never be committed.
MAIL_MAILER=log
MAIL_HOST=web218.dogado.net
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@myqr24.com
MAIL_PASSWORD=replace-with-dogado-mailbox-password
MAIL_FROM_ADDRESS="no-reply@myqr24.com"
MAIL_FROM_NAME="myQR24 TAG Control Center"

# CLI-only bootstrap. Do not expose these values through web routes or TCC.
TCP_BOOTSTRAP_ADMIN_EMAIL=azis213@gmail.com
TCP_BOOTSTRAP_ADMIN_INITIAL_PASSWORD=replace-with-a-local-random-password

# Server-enforced transitional email MFA policy.
TCP_EMAIL_MFA_ENABLED=true
TCP_EMAIL_MFA_CODE_TTL_SECONDS=600
TCP_EMAIL_MFA_MAX_ATTEMPTS=5
TCP_EMAIL_MFA_RESEND_COOLDOWN_SECONDS=60

# Server-side password re-authentication window for critical W2L tag-management commands.
TCP_TAG_MANAGEMENT_REAUTH_TTL_SECONDS=900
