{
  "schema": "myqr24-tag-content-template-v1",
  "schemaVersion": 3,
  "template": {
    "templateId": "tct_example_wedding_party",
    "templateVersion": 1,
    "tagType": "event",
    "name": "Hochzeit – Abendparty",
    "description": "Beispiel: dunkles Party-Layout mit Getränkekarte als Tabelle, Partyfotos, Ablaufplan und Playlist.",
    "locale": "de-DE",
    "status": "draft",
    "compatibility": {
      "protectionModes": ["public", "pin_required"],
      "presentations": ["wedding"]
    }
  },
  "shell": {
    "presentation": "wedding",
    "features": ["vault"],
    "theme": {
      "colorMode": "dark",
      "colors": {
        "background": "#141018",
        "surface": "#1e1826",
        "text": "#f3ecff",
        "mutedText": "#b4a8c6",
        "heading": "#ffe9a8",
        "accent": "#e2a33c",
        "accentText": "#141018",
        "border": "#342a44",
        "danger": "#ff8a80",
        "success": "#7fd6a0"
      },
      "typography": { "fontFamily": "system", "headingScale": 1.1, "bodySize": 16, "lineHeight": 1.6 },
      "layout": { "contentWidth": "narrow", "density": "comfortable", "cornerStyle": "round" }
    },
    "navigation": { "mode": "single", "items": [] },
    "statusBar": { "showTagId": true, "showPresentation": false }
  },
  "layout": {
    "mode": "grid-flow",
    "columns": 12,
    "gap": "md",
    "container": { "maxWidth": "narrow", "padding": "normal" },
    "responsive": {
      "autoReflow": true,
      "minColumnWidth": { "tablet": "16rem", "desktop": "20rem" },
      "preferredColumns": { "mobile": 1, "tablet": 2, "desktop": 2 }
    }
  },
  "elements": [
    {
      "elementId": "cel_theme",
      "elementType": "theme-assets",
      "displayOrder": 0,
      "visibility": "public",
      "hidden": true,
      "payload": { "role": "background" },
      "slots": [
        { "slotId": "tag-background", "accepts": ["image"], "min": 0, "max": 1, "required": false }
      ]
    },
    {
      "elementId": "cel_hero",
      "elementType": "hero",
      "displayOrder": 10,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 12 },
        "order": { "mobile": 10, "tablet": 10, "desktop": 10 }
      },
      "payload": { "variant": "cover" },
      "bindings": { "title": { "from": "tag.displayName" } },
      "content": { "paragraphs": [{ "runs": [{ "text": "Tanzen, bis die Lichter ausgehen." }] }] },
      "slots": [
        { "slotId": "cover", "accepts": ["image"], "min": 0, "max": 1, "required": false, "presentation": { "fit": "cover" } }
      ]
    },
    {
      "elementId": "cel_dress",
      "elementType": "callout",
      "displayOrder": 20,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 6 },
        "order": { "mobile": 20, "tablet": 20, "desktop": 20 }
      },
      "payload": { "tone": "notice" },
      "content": {
        "paragraphs": [
          { "heading": 4, "runs": [{ "text": "Dresscode & Zeiten" }] },
          { "runs": [{ "text": "Ab 20 Uhr wird gefeiert – festlich, aber tanzbar. " }, { "text": "Hohe Absätze im Garten bitte vermeiden.", "marks": [{ "type": "italic" }] }] }
        ]
      }
    },
    {
      "elementId": "cel_bar",
      "elementType": "text",
      "displayOrder": 30,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 6 },
        "order": { "mobile": 30, "tablet": 30, "desktop": 30 }
      },
      "style": { "background": { "type": "solid", "color": "surface" }, "padding": "md" },
      "payload": { "headingLevel": "h2", "align": "start", "maxParagraphs": 8 },
      "content": {
        "paragraphs": [
          { "heading": 3, "runs": [{ "text": "Bar & Getränke" }] },
          {
            "type": "table",
            "columns": [{ "align": "start" }, { "align": "end" }, { "align": "start" }],
            "rows": [
              {
                "header": true,
                "cells": [
                  { "runs": [{ "text": "Getränk" }], "background": "#2a2237" },
                  { "runs": [{ "text": "Preis" }], "background": "#2a2237" },
                  { "runs": [{ "text": "Hinweis" }], "background": "#2a2237" }
                ]
              },
              {
                "cells": [
                  { "runs": [{ "text": "Aperol Spritz" }] },
                  { "runs": [{ "text": "7 €" }] },
                  { "runs": [{ "text": "mit Orangenscheibe" }] }
                ]
              },
              {
                "cells": [
                  { "runs": [{ "text": "Gin Tonic" }], "background": "#241d2f" },
                  { "runs": [{ "text": "8 €" }], "background": "#241d2f" },
                  { "runs": [{ "text": "Basilikum optional" }], "background": "#241d2f" }
                ]
              },
              {
                "cells": [
                  { "runs": [{ "text": "Hausgemachte Limonade" }] },
                  { "runs": [{ "text": "4 €" }] },
                  { "runs": [{ "text": "Holunder oder Zitrone" }] }
                ]
              },
              {
                "cells": [
                  { "runs": [{ "text": "Bier vom Fass" }], "background": "#241d2f" },
                  { "runs": [{ "text": "4,50 €" }], "background": "#241d2f" },
                  { "runs": [{ "text": "aus der Region" }], "background": "#241d2f" }
                ]
              },
              {
                "cells": [
                  { "runs": [{ "text": "Alkoholfrei" }] },
                  { "runs": [{ "text": "0 €" }] },
                  { "runs": [{ "text": "Wasser, Saft, Kaffee" }] }
                ]
              }
            ],
            "border": { "color": "#4a3b5e", "style": "solid", "width": 1 }
          }
        ]
      }
    },
    {
      "elementId": "cel_gallery",
      "elementType": "gallery",
      "displayOrder": 40,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 12 },
        "order": { "mobile": 40, "tablet": 40, "desktop": 40 }
      },
      "payload": {
        "name": "Partyfotos",
        "picker": { "axis": "horizontal", "thumbSize": "lg", "showCounter": true },
        "viewer": { "sizeMode": "large", "swipe": true, "loop": true, "showCaptions": true },
        "lightbox": true,
        "maxImages": 48
      },
      "content": { "paragraphs": [{ "heading": 3, "runs": [{ "text": "Partyfotos" }] }] },
      "actions": {
        "upload": { "enabled": false },
        "download": { "enabled": true, "principals": ["scanner", "guest", "owner"] }
      },
      "slots": [
        {
          "slotId": "images",
          "accepts": ["image"],
          "min": 0,
          "max": 48,
          "required": false,
          "presentation": { "fit": "cover", "caption": "optional", "downloadable": true }
        }
      ]
    },
    {
      "elementId": "cel_docs",
      "elementType": "documents",
      "displayOrder": 50,
      "visibility": "shared",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 8 },
        "order": { "mobile": 50, "tablet": 50, "desktop": 50 }
      },
      "payload": { "view": "list", "showMeta": true, "sort": "date-asc", "maxItems": 16 },
      "content": { "paragraphs": [{ "heading": 3, "runs": [{ "text": "Ablaufplan" }] }] },
      "actions": {
        "upload": { "enabled": false },
        "download": { "enabled": true, "principals": ["guest", "owner"] }
      },
      "slots": [
        { "slotId": "documents", "accepts": ["document"], "min": 0, "max": 16, "required": false }
      ]
    },
    {
      "elementId": "cel_link",
      "elementType": "external-link",
      "displayOrder": 60,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 4 },
        "order": { "mobile": 60, "tablet": 60, "desktop": 60 }
      },
      "payload": { "display": "button" },
      "copy": { "label": "Playlist öffnen", "url": "https://example.org/playlist" },
      "content": {
        "paragraphs": [
          { "heading": 4, "runs": [{ "text": "Musikwünsche" }] },
          { "runs": [{ "text": "Tragt eure Wünsche in die Liste ein – wir spielen sie in der Pause." }] }
        ]
      }
    },
    {
      "elementId": "cel_divider",
      "elementType": "divider",
      "displayOrder": 70,
      "visibility": "public",
      "placement": {
        "span": { "mobile": 12, "tablet": 12, "desktop": 12 },
        "order": { "mobile": 70, "tablet": 70, "desktop": 70 }
      },
      "payload": { "style": "line" }
    }
  ]
}
