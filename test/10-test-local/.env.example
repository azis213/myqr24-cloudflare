# Ausschließlich synthetische lokale Werte. Keine Staging- oder Produktionssecrets verwenden.
LOCAL_MYSQL_DATABASE=myqr24_local
LOCAL_MYSQL_TEST_DATABASE=myqr24_test
LOCAL_MYSQL_USER=myqr24_local
LOCAL_MYSQL_PASSWORD=local-development-password-change-me
LOCAL_MYSQL_ROOT_PASSWORD=local-root-password-change-me

# Mit `php artisan key:generate --show` erzeugen; dieser Beispielwert ist nur lokal.
LOCAL_APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LOCAL_TCP_PORT=8080
LOCAL_TCC_PORT=5174
LOCAL_TAG_APP_PORT=5173

# Ausschließlich für den Compose-internen Private-Codec. Dieser Wert wird weder
# veröffentlicht noch an TCC oder Browser weitergegeben.
LOCAL_CODEC_API_KEY=replace-with-a-local-random-codec-service-key
LOCAL_CODEC_FEISTEL_SECRET=replace-with-at-least-32-random-local-bytes

# Wird beim lokalen TCP-Start idempotent erstellt. Das Passwort vor dem ersten Start
# durch einen lokal erzeugten Zufallswert ersetzen; .env.local wird nicht versioniert.
TCP_BOOTSTRAP_ADMIN_EMAIL=azis213@gmail.com
TCP_BOOTSTRAP_ADMIN_INITIAL_PASSWORD=replace-with-a-local-random-password

# Lokaler Direktlogin ohne E-Mail-MFA. In Staging/Produktion auf `true` setzen.
TCP_EMAIL_MFA_ENABLED=false

# Lokaler Standard: keine externe E-Mail versenden. Für Staging/Produktion Dogado
# SMTP aktivieren; das Postfachpasswort gehört ausschließlich in den Secret Store.
MAIL_MAILER=log
MAIL_HOST=web218.dogado.net
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@myqr24.com
MAIL_PASSWORD=replace-with-dogado-mailbox-password
MAIL_FROM_ADDRESS=no-reply@myqr24.com
MAIL_FROM_NAME=myQR24 TAG Control Center
