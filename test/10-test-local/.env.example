# Ausschließlich synthetische lokale Werte. Keine Staging- oder Produktionssecrets verwenden.
LOCAL_MYSQL_DATABASE=myqr24_local
LOCAL_MYSQL_TEST_DATABASE=myqr24_test
LOCAL_MYSQL_USER=myqr24_local
LOCAL_MYSQL_PASSWORD=local-development-password-change-me
LOCAL_MYSQL_ROOT_PASSWORD=local-root-password-change-me

# Mit `php artisan key:generate --show` erzeugen; dieser Beispielwert ist nur lokal.
LOCAL_APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LOCAL_TCP_PORT=8080
LOCAL_TCC_PORT=5174
